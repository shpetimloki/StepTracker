<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Abmelden-Button oben links (größer, mit sichtbarem Icon) -->
    <Button
        android:id="@+id/logoutButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/circle_button"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_margin="8dp"
        android:drawableStart="@drawable/ic_logout"
        android:drawableTint="@android:color/white"
        android:padding="8dp"
        android:contentDescription="Abmelden" />

    <!-- Ziel ändern-Button oben rechts (größer, mit sichtbarem Icon) -->
    <Button
        android:id="@+id/changeGoalButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/circle_button"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_margin="8dp"
        android:drawableStart="@drawable/ic_settings"
        android:drawableTint="@android:color/white"
        android:padding="8dp"
        android:contentDescription="Ziel ändern" />

    <!-- Aktuelle Schritte zentral in der Mitte -->
    <TextView
        android:id="@+id/goalTextView"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:gravity="center"
        android:background="@drawable/circle_background"
        android:padding="20dp"
        android:text="5000 von 10000\nSchritten erreicht"
        android:textSize="20sp"
        android:textColor="#000000"
        android:layout_centerInParent="true" />

    <!-- Navigationsleiste unten -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_alignParentBottom="true">

        <!-- Wochenübersicht -->
        <Button
            android:id="@+id/weekOverviewButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Wochen Übersicht" />

        <!-- Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#000" />

        <!-- Monatsübersicht -->
        <Button
            android:id="@+id/monthOverviewButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Monats Übersicht" />
    </LinearLayout>
</RelativeLayout>
